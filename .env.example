# Only NEXT_PUBLIC_SITE_URL is required to build and run the landing page.
# Every other feature (auth, checkout, storage, email, newsletter) is
# feature-flagged and shows a dev warning instead of crashing when its keys are missing.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk — auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe — payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROGRAM=
STRIPE_PRICE_COACH=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ADAPTED_PROGRAM=
STRIPE_PRICE_ADAPTED_COACH=
STRIPE_PRICE_ADAPTED_PREMIUM=

# Upstash Redis — workout logs, PRs, check-ins, intakes
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — email to the coach
RESEND_API_KEY=
COACH_EMAIL=

# Cal.com — adapted assessment booking (e.g. https://cal.com/your-name/assessment)
NEXT_PUBLIC_CALCOM_LINK=

# Newsletter — "brevo" or "mailchimp"
NEWSLETTER_PROVIDER=
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=
